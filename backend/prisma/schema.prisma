generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  TECH
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id         String        @id @default(uuid())
  tenantKey String        @unique
  name       String
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  clients      Client[]
  sellers      Seller[]
  lots         Lot[]
  sales        Sale[]
  installments Installment[]
  payments     Payment[]
  paymentReminderNotifications PaymentReminderNotification[]
  lateFeeSnapshots LateFeeSnapshot[]
  syncBatches  SyncBatch[]
}

model Client {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  syncId    String
  name      String
  document  String?
  phone     String?
  address   String?
  raw        Json?
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model Seller {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  syncId    String
  name      String
  document  String?
  phone     String?
  active    Boolean  @default(true)
  raw       Json?
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model Lot {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  syncId    String
  block     String?
  number    String?
  status    String?
  area      Decimal? @db.Decimal(14, 2)
  price     Decimal? @db.Decimal(14, 2)
  raw       Json?
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model Sale {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  syncId       String
  clientSyncId String?
  lotSyncId    String?
  sellerSyncId String?
  saleDate     DateTime?
  status       String?
  total        Decimal  @default(0) @db.Decimal(14, 2)
  initialPaid  Decimal  @default(0) @db.Decimal(14, 2)
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  raw          Json?
  version      Int      @default(1)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model Installment {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  syncId              String
  saleSyncId          String?
  installmentNumber   Int?
  dueDate             DateTime?
  openingBalance      Decimal  @default(0) @db.Decimal(14, 2)
  principalAmount     Decimal  @default(0) @db.Decimal(14, 2)
  interestAmount      Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal  @default(0) @db.Decimal(14, 2)
  paidAmount          Decimal  @default(0) @db.Decimal(14, 2)
  paidPrincipalAmount Decimal  @default(0) @db.Decimal(14, 2)
  paidInterestAmount  Decimal  @default(0) @db.Decimal(14, 2)
  endingBalance       Decimal  @default(0) @db.Decimal(14, 2)
  status              String?
  raw                 Json?
  version             Int      @default(1)
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model Payment {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  syncId            String
  saleSyncId        String?
  clientSyncId      String?
  installmentSyncId String?
  paidAt            DateTime?
  amount            Decimal  @default(0) @db.Decimal(14, 2)
  method            String?
  paymentType       String?
  reference         String?
  yearToPay         Int?
  raw               Json?
  version           Int      @default(1)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, syncId])
  @@index([companyId, updatedAt])
}

model SyncBatch {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  deviceId      String
  receivedCounts Json
  appliedCounts  Json
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
}

model PaymentReminderNotification {
  id                            String   @id @default(uuid())
  companyId                     String
  company                       Company  @relation(fields: [companyId], references: [id])
  clientSyncId                  String?
  saleSyncId                    String
  type                          String
  period                        String?
  lastOverdueInstallmentSyncId  String
  overdueInstallmentCount       Int
  pendingPrincipal              Decimal  @default(0) @db.Decimal(14, 2)
  lateFeeTotal                  Decimal  @default(0) @db.Decimal(14, 2)
  totalDue                      Decimal  @default(0) @db.Decimal(14, 2)
  destinationPhone              String?
  templateName                  String?
  whatsappMessageId             String?
  status                        String   @default("PENDING")
  attempts                      Int      @default(0)
  error                         String?
  scheduledAt                   DateTime?
  sentAt                        DateTime?
  payload                       Json?
  testMode                      Boolean  @default(false)
  redirected                    Boolean  @default(false)
  originalRecipientMasked       String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  deliveries                    PaymentReminderDelivery[]

  @@unique([companyId, saleSyncId, type, lastOverdueInstallmentSyncId])
  @@index([companyId, status, createdAt])
  @@index([companyId, whatsappMessageId])
}

model PaymentReminderDelivery {
  id                       String   @id @default(uuid())
  notificationId           String
  notification             PaymentReminderNotification @relation(fields: [notificationId], references: [id])
  actualRecipient          String
  originalRecipientMasked  String?
  testMode                 Boolean  @default(false)
  redirected               Boolean  @default(false)
  whatsappMessageId        String?
  status                   String   @default("PENDING")
  attempts                 Int      @default(0)
  error                    String?
  sentAt                   DateTime?
  deliveredAt              DateTime?
  readAt                   DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([notificationId, actualRecipient])
  @@index([whatsappMessageId])
  @@index([status, createdAt])
}

model LateFeeSnapshot {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  clientSyncId        String?
  saleSyncId          String
  installmentSyncId   String
  calculatedAt        DateTime
  baseBalance         Decimal  @default(0) @db.Decimal(14, 2)
  overdueDays         Int
  dailyRate           Decimal  @default(0) @db.Decimal(8, 6)
  calculatedLateFee   Decimal  @default(0) @db.Decimal(14, 2)
  eventType           String
  notificationId      String?
  createdAt           DateTime @default(now())

  @@index([companyId, saleSyncId, calculatedAt])
  @@index([companyId, installmentSyncId])
}
