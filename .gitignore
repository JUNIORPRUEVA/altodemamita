# ============================================
# SISTEMA SOLARES - .gitignore raíz
# ============================================

# --- Archivos de base de datos ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.journal
*.dump
*.sqlite
*.sqlite3

# --- Build artifacts (recursivo) ---
**/build/
**/dist/
**/.dart_tool/
**/node_modules/

# --- Backups ---
backups/
backups_audit/
**/backups/
**/backups_audit/
**/backup/

# --- Instaladores y binarios ---
*.apk
*.aab
*.exe
*.msi
*.zip
*.7z
*.rar
*.tar.gz
*.tar

# --- IDE / Editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Logs y temporales ---
*.log
*.jsonl
*.tmp
*.temp
*.swp
*.pid
*.class
*.pyc
.DS_Store
.history
tmp/
**/tmp/
temp/
**/temp/

# --- Flutter/Dart ---
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/
.dart_tool/

# --- Symbolication ---
app.*.symbols
app.*.map.json

# --- Android Studio ---
/android/app/debug
/android/app/profile
/android/app/release
**/android/key.properties
**/android/*.jks
**/android/*.keystore

# --- Otros ---
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/

# --- Probes (datos simulados de entorno limpio) ---
tools/probes/

# --- Output de scripts ---
tools/scripts/probe_output_new.json

# --- Docs misceláneos (capturas, dumps) ---
docs/misc/
docs/logs/

# --- Distribuciones / releases locales ---
dist_release/
release_artifacts/
app_local/instalacion/output/
app_owner/instalacion/output/

# --- Evidencia sensible de migración / cutover ---
customer_migration_report.json
customer_migration_report.md
tmp/customer_migration/
tmp/final_cutover/customer_source_original/
tmp/final_cutover/customer_working/

# --- Archivo de entorno ---
.env
*.env
*.pem
*.key
