FROM ghcr.io/cirruslabs/flutter:3.38.5 AS build

WORKDIR /app

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
RUN flutter build web --release --no-wasm-dry-run

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-pwa.sh /docker-entrypoint.d/40-sistema-solares-runtime-config.sh
COPY --from=build /app/build/web /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.d/40-sistema-solares-runtime-config.sh

EXPOSE 80
