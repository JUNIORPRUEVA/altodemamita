{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App Local Web Chrome DEV",
      "request": "launch",
      "type": "dart",
      "cwd": "app_local",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=SYNC_API_BASE_URL=https://altomamita-backend.gcdndd.easypanel.host",
        "--dart-define=CLOUD_CUTOVER_MODE=CLOUD_AUTHORITATIVE",
        "--dart-define=ALLOW_CLOUD_PULL=true",
        "--dart-define=ALLOW_LEGACY_MIGRATION=false",
        "--dart-define=ALLOW_AUTH_BOOTSTRAP=false"
      ]
    },
    {
      "name": "App Local Windows DEV",
      "request": "launch",
      "type": "dart",
      "cwd": "app_local",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "windows",
      "toolArgs": [
        "--dart-define=SYNC_API_BASE_URL=https://altomamita-backend.gcdndd.easypanel.host",
        "--dart-define=CLOUD_CUTOVER_MODE=CLOUD_AUTHORITATIVE",
        "--dart-define=ALLOW_CLOUD_PULL=true",
        "--dart-define=ALLOW_LEGACY_MIGRATION=false",
        "--dart-define=ALLOW_AUTH_BOOTSTRAP=false"
      ]
    },
    {
      "name": "App Owner DEV",
      "request": "launch",
      "type": "dart",
      "cwd": "app_owner",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "emulator",
      "toolArgs": [
        "--dart-define=OWNER_API_BASE_URL=https://altomamita-backend.gcdndd.easypanel.host"
      ]
    },
    {
      "name": "Backend DEV",
      "type": "node",
      "request": "launch",
      "cwd": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal"
    }
  ]
}
